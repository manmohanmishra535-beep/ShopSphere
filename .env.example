# ShopSphere — local environment
# Copy to `.env` (repo root) or `api/.env` and restart `npm run dev`.

# --- API -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Change this before deploying. Any long random string is fine.
JWT_SECRET=shopsphere-dev-secret-change-me

# Seed the demo catalogue, users and orders when the database is empty.
SEED_DEMO=true

# --- Database --------------------------------------------------------------
# Leave both unset to use the zero-config JSON database (api/src/data/db.json).
# Set MONGODB_URI to persist the same data model in MongoDB collections.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=shopsphere

# Optional JSON path when MongoDB is not used. Defaults to api/src/data/db.json.
# DB_FILE=C:\path\to\db.json

# --- Cache -----------------------------------------------------------------
# Leave unset for the in-process TTL cache. Set REDIS_URL for a shared cache
# across API instances (rate limits and catalogue caches use Redis then).
# REDIS_URL=redis://127.0.0.1:6379

# --- Payments --------------------------------------------------------------
# `mock` is the built-in demo provider. `razorpay` creates real Orders and
# verifies HMAC signatures client-side and on the webhook.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used to verify the `x-razorpay-signature` header on POST /api/v1/webhooks/razorpay
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Media (Cloudinary) ----------------------------------------------------
# All three values enable real signed direct uploads from the admin console.
# With them unset, POST /api/v1/media/sign returns a clearly labelled demo signature.
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDINARY_UPLOAD_FOLDER=shopsphere/products
# Optional unsigned/signed preset to apply to uploads.
# CLOUDINARY_UPLOAD_PRESET=shopsphere-products

# --- Web -------------------------------------------------------------------
# The Next.js app rewrites /api/v1/* to this origin. Defaults to localhost:4000.
# Set API_URL in web/.env.local when the API runs elsewhere.
# API_URL=http://localhost:4000
