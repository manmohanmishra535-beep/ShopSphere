# ShopSphere — local environment
# Copy to `.env` (repo root) or `api/.env` and restart `npm run dev`.

# --- API -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Change this before deploying. Any long random string is fine.
JWT_SECRET=shopsphere-dev-secret-change-me

# Path to the JSON data file. Defaults to api/src/data/db.json.
# DB_FILE=C:\path\to\db.json

# Seed the demo catalogue, users and orders when the data file is missing.
SEED_DEMO=true

# Payment adapter: `mock` is built in. Production would plug Razorpay/Stripe
# into api/src/modules/payments and verify webhook signatures server-side.
PAYMENT_PROVIDER=mock

# --- Web -------------------------------------------------------------------
# The Next.js app rewrites /api/v1/* to this origin. Defaults to localhost:4000.
# Set API_URL in web/.env.local when the API runs elsewhere.
# API_URL=http://localhost:4000
